  {
    "cell_type": "markdown",
    "source": [
      "## Example 4: Volume and Catalyst Needed for 90% Conversion"
    ],
    "metadata": {
      "id": "1y09Va54KdmS"
    },
    "id": "1y09Va54KdmS"
  },
  {
    "cell_type": "code",
    "source": [
      "target = 0.90\n",
      "\n",
      "def objective(Vf):\n",
      "    s = solve_ivp(pfr_ode,[0,Vf],[0],t_eval=[Vf])\n",
      "    return s.y[0,-1] - target\n",
      "\n",
      "root = root_scalar(objective, bracket=[0.001,50])\n",
      "Vreq = root.root\n",
      "print(\"Required reactor volume (L)=\",Vreq)\n",
      "\n",
      "rho_b = 500 # kg/m^3\n",
      "W = (Vreq/1000)*rho_b\n",
      "print(\"Catalyst mass (kg)=\",W)"
    ],
    "metadata": {
