  {
    "cell_type": "markdown",
    "source": [
      "## Example 3: No Catalyst Case"
    ],
    "metadata": {
      "id": "5bw0Go_YKYtl"
    },
    "id": "5bw0Go_YKYtl"
  },
  {
    "cell_type": "code",
    "source": [
      "k_nc = 1\n",
      "\n",
      "def rate_no_cat(X):\n",
      "    PA = PA0*(1-X)/(1-X/2)\n",
      "    return -k_nc*PA**2\n",
      "\n",
      "def pfr_ode_no_cat(V,y):\n",
      "    return [(-rate_no_cat(y[0]))/FA0]\n",
      "\n",
      "sol_nc = solve_ivp(pfr_ode_no_cat,[0,1],[0],t_eval=np.linspace(0,1,200))\n",
      "print(\"1 L PFR without catalyst, X =\", sol_nc.y[0,-1])"
    ],
    "metadata": {
      "colab": {
        "base_uri": "https://localhost:8080/"
